# =========================================================
# PAYFLOW DOCKER DEVELOPMENT ENVIRONMENT
#
# Local development credentials only.
# Production secret management comes in Part 13.
# =========================================================


# =========================================================
# POSTGRESQL
# =========================================================

POSTGRES_DB=mlflow
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=payflow_mlflow_dev

# Host port.
# Containers communicate internally on postgres:5432.
POSTGRES_HOST_PORT=5433


# =========================================================
# MINIO
# =========================================================

MINIO_ROOT_USER=payflowminio
MINIO_ROOT_PASSWORD=payflow_minio_dev_12345

MLFLOW_BUCKET=mlflow

# S3-compatible API
MINIO_API_PORT=9000

# Browser console
MINIO_CONSOLE_PORT=9001


# =========================================================
# MLFLOW
#
# Existing local MLflow:
# http://127.0.0.1:5000
#
# Docker MLflow:
# http://127.0.0.1:5050
# =========================================================

MLFLOW_HOST_PORT=5050


# =========================================================
# FASTAPI
#
# Existing local FastAPI:
# http://127.0.0.1:8000
#
# Docker FastAPI:
# http://127.0.0.1:8001
# =========================================================

FASTAPI_HOST_PORT=8001